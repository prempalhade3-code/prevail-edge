# PREVAIL environment template — copy to .env and adjust for local dev

# Rust runtime
PREVAIL_RUNTIME_HOST=127.0.0.1
PREVAIL_RUNTIME_PORT=8090
PREVAIL_PREDICTOR_URL=http://127.0.0.1:8091
PREVAIL_EDGE_REGIONS_PATH=deploy/config/edge-regions.json
PREVAIL_EDGE_CAPABILITIES_PATH=deploy/config/edge-capabilities.json

# FastAPI backend
PREVAIL_RUNTIME_URL=http://127.0.0.1:8090
PREVAIL_API_HOST=0.0.0.0
PREVAIL_API_PORT=8000
PREVAIL_DATABASE_URL=postgresql://prevail:prevail_password@127.0.0.1:5432/prevail

# Vehicle sim (optional live ingest)
# PREVAIL_RUNTIME_URL=http://127.0.0.1:8090
# PREVAIL_PREDICTOR_URL=http://127.0.0.1:8091

# Flink job / experiment runner
PREVAIL_SIDECAR_URL=http://127.0.0.1:8090
PREVAIL_INTEGRATION_TESTS=0

# Frontend (optional)
# VITE_WS_URL=ws://127.0.0.1:8000/ws/live
