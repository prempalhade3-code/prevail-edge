{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrajectorySample",
  "description": "Vehicle mobility sample (proto-compatible JSON). Owner: Chirag. Consumer: Prem runtime, Atharva training.",
  "type": "object",
  "required": ["session_id", "timestamp_ms", "latitude", "longitude", "speed_mps", "edge_id"],
  "properties": {
    "session_id": { "type": "string" },
    "timestamp_ms": { "type": "integer" },
    "latitude": { "type": "number" },
    "longitude": { "type": "number" },
    "speed_mps": { "type": "number", "minimum": 0 },
    "edge_id": { "type": "string", "examples": ["edge-a", "edge-b"] },
    "heading_deg": { "type": "number" }
  }
}
