{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimelineEvent",
  "description": "Dashboard/Postgres audit event. Emitter: Rust runtime. Consumer: Postgres, UI.",
  "type": "object",
  "required": ["run_id", "timestamp_ms", "event_type", "message"],
  "properties": {
    "run_id": { "type": "string" },
    "timestamp_ms": { "type": "integer" },
    "event_type": {
      "type": "string",
      "enum": [
        "VehicleConnected",
        "AuthorityGranted",
        "MeshAttached",
        "PredictionIssued",
        "PredictionDegraded",
        "HandoffDetected",
        "ShadowCreated",
        "ShadowRefused",
        "ShadowPrepared",
        "ShadowReleased",
        "ShadowSyncUpdate",
        "SpeculationSkipped",
        "ShadowDiscarded",
        "MigrationFallback",
        "AuthorityTransferFailed",
        "AuthorityTransferRejected",
        "AuthorityTransferred",
        "EdgePromoted",
        "EdgeDemoted",
        "WrongPrediction",
        "PromotionAck",
        "MigrationFallbackStart",
        "MigrationFallbackComplete",
        "FlinkStateAligned",
        "FlinkOutputGateUpdated",
        "SpeculationDecision",
        "ShadowRecreated",
        "AuthorityFailover"
      ]
    },
    "edge_id": { "type": "string" },
    "payload": { "type": "object" },
    "message": { "type": "string" }
  }
}
